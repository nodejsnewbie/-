{
  "name": "hnhall",
  "private": true,
  "version": "1.0.0",
  "description": "华农智服 · 农资上门服务维保平台（monorepo：企业后台 / 技师端 / C 端商城 / 统一后端）",
  "workspaces": [
    "apps/*",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @hnhall/server",
    "dev:admin": "npm run dev -w @hnhall/admin",
    "dev:server": "npm run dev -w @hnhall/server",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present",
    "start": "npm run start -w @hnhall/server",
    "dev:mall": "npm run dev -w @hnhall/mall"
  },
  "engines": {
    "node": ">=20"
  }
}
