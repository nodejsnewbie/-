# AI 智能代理层环境变量（复制为 .env 后填写；.env 不入库 —— 红线 R10）

# 大模型密钥（OpenAI 兼容协议）。未配置时 /api/v1/agent/chat 返回 503，不做假回答。
LLM_API_KEY=

# OpenAI 兼容网关地址与模型。国内可选：
#   豆包方舟: https://ark.cn-beijing.volces.com/api/v3  + 模型如 doubao-seed-1-6
#   智谱:     https://open.bigmodel.cn/api/paas/v4      + 模型如 glm-4.7
#   通义:     https://dashscope.aliyuncs.com/compatible-mode/v1 + qwen 系列
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3

# 平台统一后端（NestJS）地址 —— 智能代理工具的数据源
PLATFORM_API_BASE_URL=http://127.0.0.1:3000

# 本服务监听
PORT=8100
